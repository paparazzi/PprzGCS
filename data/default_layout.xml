<gcsconf>
    <layout width="1600" height="1000">
      <columns>
        <widget name="map2d" size="800">
          <configure>
            <columnLeft>
                <widget name="layers" icon="rail_layers.svg" title="Map layers"/>
                <widget name="gps_classic_viewer" icon="rail_gps.svg" title="GPS"/>
                <widget name="chat" icon="rail_chat.svg" title="Chat"/>
                <widget name="PFD" icon="rail_pfd.svg" title="PFD"/>
                <widget name="link_status" icon="rail_link.svg" title="Link status"/>
                <widget name="plotter" icon="rail_plotter.svg" title="Plots">
                    <configure>
                        <plot preset="battery"/>
                    </configure>
                </widget>
                <widget name="video" icon="rail_video.svg" title="Video">
                    <configure source="udp://:5600" width="320"/>
                </widget>
            </columnLeft>
          </configure>
        </widget>
        <rows size="200" id="right_pane">
            <widget name="strips" container="list" alt="commands"/>
            <tabs size="30">
                <widget name="flightplan" title="Flight plan"/>
                <widget name="settings" title="Settings"/>
                <widget name="checklist" title="Checklist"/>
            </tabs>
        </rows>
      </columns>
    </layout>
    <speech locale="en_GB">
        <message name="ground:FLIGHT_PARAM:agl" text="{AC} altitude, {value} meters AGL" timeout="20" expire="10" priority="1"/>
        <!--message name="ground:FLIGHT_PARAM:airspeed" text="airspeed.. {value} meters per second" timeout="20" expire="10" priority="0"/-->
        <message name="ground:AP_STATUS:ap_mode" text="mode {value}" timeout="0" expire="20" priority="2" onChange="true"/>
        <message name="ground:NAV_STATUS:cur_block" text="block {value}" timeout="0" expire="10" priority="0" onChange="true" postprocessing="block"/>
        
    </speech>
    
</gcsconf>
